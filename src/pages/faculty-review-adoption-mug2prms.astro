---
import Base from '../layouts/Base.astro';
import { pageTitle } from '../data/site';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'faculty-review-adoption-mug2prms');
const d = entry.data;

const countries = [
  'United States', 'United Kingdom', 'Afghanistan', 'Albania', 'Algeria', 'Andorra', 'Angola',
  'Antigua and Barbuda', 'Argentina', 'Armenia', 'Australia', 'Austria', 'Azerbaijan', 'Bahamas',
  'Bahrain', 'Bangladesh', 'Barbados', 'Belarus', 'Belgium', 'Belize', 'Benin', 'Bhutan',
  'Bolivia', 'Bosnia and Herzegovina', 'Botswana', 'Brazil', 'Brunei', 'Bulgaria', 'Burkina Faso',
  'Burundi', 'Cabo Verde', 'Cambodia', 'Cameroon', 'Canada', 'Central African Republic', 'Chad',
  'Chile', 'China', 'Colombia', 'Comoros', 'Congo', 'Costa Rica', 'Croatia', 'Cuba', 'Cyprus',
  'Czechia', 'Democratic Republic of the Congo', 'Denmark', 'Djibouti', 'Dominica',
  'Dominican Republic', 'Ecuador', 'Egypt', 'El Salvador', 'Equatorial Guinea', 'Eritrea',
  'Estonia', 'Eswatini', 'Ethiopia', 'Fiji', 'Finland', 'France', 'Gabon', 'Gambia', 'Georgia',
  'Germany', 'Ghana', 'Greece', 'Grenada', 'Guatemala', 'Guinea', 'Guinea-Bissau', 'Guyana',
  'Haiti', 'Honduras', 'Hungary', 'Iceland', 'India', 'Indonesia', 'Iran', 'Iraq', 'Ireland',
  'Israel', 'Italy', 'Jamaica', 'Japan', 'Jordan', 'Kazakhstan', 'Kenya', 'Kiribati', 'Kosovo',
  'Kuwait', 'Kyrgyzstan', 'Laos', 'Latvia', 'Lebanon', 'Lesotho', 'Liberia', 'Libya',
  'Liechtenstein', 'Lithuania', 'Luxembourg', 'Madagascar', 'Malawi', 'Malaysia', 'Maldives',
  'Mali', 'Malta', 'Marshall Islands', 'Mauritania', 'Mauritius', 'Mexico', 'Micronesia',
  'Moldova', 'Monaco', 'Mongolia', 'Montenegro', 'Morocco', 'Mozambique', 'Myanmar', 'Namibia',
  'Nauru', 'Nepal', 'Netherlands', 'New Zealand', 'Nicaragua', 'Niger', 'Nigeria',
  'North Korea', 'North Macedonia', 'Norway', 'Oman', 'Pakistan', 'Palau', 'Palestine', 'Panama',
  'Papua New Guinea', 'Paraguay', 'Peru', 'Philippines', 'Poland', 'Portugal', 'Qatar',
  'Romania', 'Russia', 'Rwanda', 'Saint Kitts and Nevis', 'Saint Lucia',
  'Saint Vincent and the Grenadines', 'Samoa', 'San Marino', 'Sao Tome and Principe',
  'Saudi Arabia', 'Senegal', 'Serbia', 'Seychelles', 'Sierra Leone', 'Singapore', 'Slovakia',
  'Slovenia', 'Solomon Islands', 'Somalia', 'South Africa', 'South Korea', 'South Sudan',
  'Spain', 'Sri Lanka', 'Sudan', 'Suriname', 'Sweden', 'Switzerland', 'Syria', 'Taiwan',
  'Tajikistan', 'Tanzania', 'Thailand', 'Timor-Leste', 'Togo', 'Tonga', 'Trinidad and Tobago',
  'Tunisia', 'Turkey', 'Turkmenistan', 'Tuvalu', 'Uganda', 'Ukraine', 'United Arab Emirates',
  'Uruguay', 'Uzbekistan', 'Vanuatu', 'Vatican City', 'Venezuela', 'Vietnam', 'Yemen', 'Zambia',
  'Zimbabwe',
];
---
<Base title={pageTitle(d.title)} description={d.excerpt} image={d.featuredImage} noindex>
  <section class="section section--deep" style="padding:40px 0 28px">
    <div class="wrap" style="text-align:center">
      <div class="lineband">
        <h1 class="plate" style="max-width:90%; font-size:clamp(1.15rem, 1.9vw, 1.5rem)">{d.title}</h1>
      </div>
      <img src="/brand/deskcopy-label.webp" alt="Request a Desk Copy" width="420"
        style="display:block; margin:12px auto 0; max-width:88%; height:auto; transform:rotate(-1.2deg)" />
    </div>
  </section>

  <section class="section" style="padding-top:24px; padding-bottom:40px">
    <div class="wrap" style="max-width:920px">
      {/* the cover floats in the copy, so the first line sits level with the
          top of the book and the words wrap around it. Same render, same size,
          as the book page mounts. Nothing else up here: the review packet is
          on the book page they came from, and the form is what they came for. */}
      <div class="faculty-intro">
        <img class="faculty-cover" src="/uploads/2026/08/mug2prms-3d.webp"
          alt="Mixerman's Ultimate Guide to Producing Records, Music & Songs" width="428" height="540" />
        <div class="prose">
          <p><em>MIXERMAN’S Ultimate Guide to Producing Records</em> isn’t a traditional textbook — it’s a fully immersive guide that covers the entirety of the record making process. Drawing from a decades-long career producing records for both major labels and independent artists, I break down the technical into understandable terms, but also address the creative, strategic, and political decisions that drive professional record production.</p>
          <p>This book connects the dots between musical decisions and technical ones. Students learn how and why production decisions are made — all presented in a clear, conversational tone that supports both classroom use and self-guided study.</p>
        </div>
      </div>
      {/* one outside voice, and a teacher's: it answers "isn't a traditional
          textbook" from the other side of the desk */}
      <div class="prose faculty-quote">
        <div class="testimonial testimonial--smallcredit">
          <blockquote><p>“The book packs the information of a text book without reading like a text book. Read it cover to cover or flip to a section you want some insight on. You’ll refer back to it over and over.”</p></blockquote>
          <p class="who"><span><strong>Brian Funk</strong><em>Music Production Podcast</em></span></p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .faculty-quote { max-width: none; margin: 0; }
    .faculty-intro { margin-bottom: 0; }
    .faculty-intro::after { content: ""; display: block; clear: both; }
    /* the render's spine angles away to the right and the jpg carries its own
       white margin, so the float needs almost no gutter of its own */
    .faculty-cover { float: left; width: min(428px, 46vw); height: auto; margin: 0 10px 10px 0; }
    /* dropped half a line: the render's 3D top edge slopes up, so text flush
       with the box top read as standing above the book */
    .faculty-intro .prose { max-width: none; margin: 0; padding-top: .8em; }
    @media (max-width: 700px) {
      .faculty-cover { float: none; display: block; margin: 0 auto 20px; width: auto; max-width: 280px; }
      .faculty-intro .prose { padding-top: 0; }
    }

    /* The form sits on the same ink band as the contact and retreat forms,
       and wears the same white fields. It keeps its labels in view where
       those two get by on placeholders: twelve fields, three of them menus,
       is too many to name by a hint that vanishes the moment you type. */
    /* the rule behind the plate is ink everywhere else; on the ink band it has
       to be cream to be there at all, and at a third so it belongs to the band
       rather than being the brightest thing on it */
    #deskcopy .lineband::before { background: rgba(248, 241, 226, .35); }
    #deskcopy .desk-intro { max-width: 560px; margin: 24px auto 32px; }
    #deskcopy .desk-intro p { margin: 0 0 1em; }
    /* underlined for the same reason the podcast page's yellow links are */
    #deskcopy .desk-intro a { color: var(--yellow); text-decoration: underline; text-underline-offset: 3px; }
    #deskcopy .desk-intro a:hover { color: var(--cream); }
    /* Each field is as wide as what goes in it — a name is not a paragraph.
       The width rides on the field as --w, and yields on a narrow screen. */
    #deskcopy .siteform input[type="text"],
    #deskcopy .siteform input[type="email"],
    #deskcopy .siteform select { width: var(--w, 100%); max-width: 100%; border: none; }
    #deskcopy .siteform label,
    #deskcopy .siteform fieldset.shipping legend { color: var(--cream); padding: 0; margin-bottom: 6px; }
    #deskcopy .siteform .hint { color: var(--cream); opacity: .78; max-width: 46em; }
    #dc-note:empty { margin: 0; }
    #deskcopy .siteform .check label,
    #deskcopy .siteform .checkline { color: var(--cream); }
    #deskcopy .siteform .check input[type="checkbox"] { accent-color: var(--yellow); }
    /* the submit in red, the colour a buy button wears on the site */
    #deskcopy .siteform button.btn { background: var(--red); color: var(--cream); }
    #deskcopy .siteform button.btn:hover { background: var(--red-deep); color: var(--cream); }
  </style>

  <!-- DESK COPY REQUEST -->
  <section class="section section--ink" id="deskcopy" style="padding:48px 0 56px">
    <div class="wrap" style="max-width:920px">
      <article style="text-align:center">
        <div class="lineband lineband--thin">
          <h2 class="plate" style="font-size:clamp(1.1rem, 1.8vw, 1.45rem)">Desk Copy &amp; Advisory Panel Request</h2>
        </div>
        <div class="desk-intro" style="text-align:left">
          <p>
            Complete this form to request your complimentary eBook desk copy (or paperback at a
            steep discount to cover costs) for faculty review and course adoption consideration.
            I verify all requests.
          </p>
          <p>
            Each term I hold a limited number of slots for virtual class visits and Q&amp;As with
            programs that have adopted the Guide. If that interests you, tell me about your
            course through the <a href="/about-contact/">contact portal</a>.
          </p>
        </div>
        <form class="siteform" name="desk-copy" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="desk-copy" />
          <p style="display:none"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div>
            <label for="dc-name">Full Name *</label>
            <input type="text" id="dc-name" name="name" required style="--w:24ch" />
          </div>
          <div>
            <label for="dc-email">Email *</label>
            <input type="email" id="dc-email" name="email" required style="--w:30ch" />
            <p class="hint">Use your institution email if you have one — it speeds up verification.</p>
          </div>
          <div>
            <label for="dc-institution">Institution *</label>
            <input type="text" id="dc-institution" name="institution" required style="--w:34ch" />
          </div>
          <div>
            <label for="dc-role">Your Role *</label>
            <input type="text" id="dc-role" name="role" required placeholder="Professor, instructor, chair…" style="--w:28ch" />
          </div>
          <div>
            <label for="dc-country">Country *</label>
            <select id="dc-country" name="country" required autocomplete="country-name" style="--w:24ch">
              <option value="">Choose your country…</option>
              {countries.map(c => <option>{c}</option>)}
            </select>
          </div>
          <div>
            <label for="dc-advisory">Would you like to join the Advisory Group?</label>
            <select id="dc-advisory" name="advisory" style="--w:22ch">
              <option value="">Choose one…</option>
              <option>Yes</option>
              <option>No</option>
            </select>
            <p class="hint">Panel members help me refine future editions, receive complimentary copies of every new edition, and are acknowledged by name in future printings. No formal time commitment.</p>
          </div>
          <div>
            <label for="dc-format">Would you like a paperback version? *</label>
            <select id="dc-format" name="format" required style="--w:30ch">
              <option value="">Choose one…</option>
              <option value="eBook only">No — eBook only (free)</option>
              <option value="Paperback" id="dc-format-paper">Yes — add the paperback</option>
            </select>
            <p class="hint">The paperback is $15 in the US and UK, $25 everywhere else.</p>
          </div>
          <input type="hidden" id="dc-price" name="paperback-price" value="" />
          <input type="hidden" id="dc-tags" name="tags" value="Desk Copy Request" />
          <fieldset class="shipping" id="dc-shipping" hidden>
            <legend>Where do we ship your paperback?</legend>
            <div>
              <label for="dc-street">Street Address *</label>
              <input type="text" id="dc-street" name="street" autocomplete="address-line1" data-req style="--w:34ch" />
            </div>
            <div>
              <label for="dc-street2">Address 2</label>
              <input type="text" id="dc-street2" name="street2" autocomplete="address-line2" style="--w:24ch" />
            </div>
            <div>
              <label for="dc-city">City *</label>
              <input type="text" id="dc-city" name="city" autocomplete="address-level2" data-req style="--w:24ch" />
            </div>
            <div>
              <label for="dc-state">State / Province *</label>
              <input type="text" id="dc-state" name="state" autocomplete="address-level1" data-req style="--w:20ch" />
            </div>
            <div>
              <label for="dc-zip">Zip / Postal Code *</label>
              <input type="text" id="dc-zip" name="zip" autocomplete="postal-code" data-req style="--w:14ch" />
            </div>
            <div>
              <label for="dc-phone">Phone Number *</label>
              <input type="text" id="dc-phone" name="phone" inputmode="tel" autocomplete="tel" data-req style="--w:20ch" />
              <p class="hint">Needed by the shipping carrier — never used for marketing.</p>
            </div>
          </fieldset>
          <div class="check">
            <label for="dc-confirm">
              <input type="checkbox" id="dc-confirm" name="faculty-confirmation" value="Confirmed" required />
              <span>I confirm that I am a current faculty member at an accredited institution. I understand this will be verified. *</span>
            </label>
          </div>
          {/* ticked by default, like the contact and retreat forms; unticked sends nothing to Kit */}
          <label class="checkline">
            <input type="checkbox" name="subscribe" value="yes" checked />
            <span>Add me to the email list — news, posts, updates. Unsubscribe anytime.</span>
          </label>
          {/* Empty until the paperback is chosen; the eBook path says its piece on
              the thank-you page. A live region rather than a hidden one: it has
              to be in the page before its text changes for a screen reader to
              speak the change, and choosing the paperback is otherwise silent —
              six shipping fields appear and nothing says so. */}
          <p class="hint" id="dc-note" aria-live="polite"></p>
          <button class="btn" type="submit" id="dc-submit">Place Order</button>
        </form>
      </article>
    </div>
  </section>

  <script>
    const country = document.getElementById('dc-country') as HTMLSelectElement;
    const advisory = document.getElementById('dc-advisory') as HTMLSelectElement;
    const tags = document.getElementById('dc-tags') as HTMLInputElement;
    const format = document.getElementById('dc-format') as HTMLSelectElement;
    const paperOption = document.getElementById('dc-format-paper') as HTMLOptionElement;
    const shipping = document.getElementById('dc-shipping') as HTMLFieldSetElement;
    const price = document.getElementById('dc-price') as HTMLInputElement;
    const zip = document.getElementById('dc-zip') as HTMLInputElement;
    const note = document.getElementById('dc-note') as HTMLParagraphElement;
    const form = country.closest('form') as HTMLFormElement;

    function update() {
      const usuk = country.value === 'United States' || country.value === 'United Kingdom';
      const cost = usuk ? 15 : 25;
      const wantsPaper = format.value === 'Paperback';

      tags.value = advisory.value === 'Yes'
        ? 'Desk Copy Request, Advisory Panel Member'
        : 'Desk Copy Request';

      paperOption.textContent = `Yes — add the paperback ($${cost})`;
      shipping.hidden = !wantsPaper;
      shipping.querySelectorAll('input[data-req]').forEach((el) => {
        (el as HTMLInputElement).required = wantsPaper;
      });
      price.value = wantsPaper ? `$${cost}` : '';

      // US ZIPs have a fixed shape; catching typos here beats a bounced Amazon order.
      if (wantsPaper && country.value === 'United States') {
        zip.pattern = '\\d{5}(-\\d{4})?';
        zip.title = 'US ZIP code, e.g. 90210 or 90210-1234';
      } else {
        zip.removeAttribute('pattern');
        zip.removeAttribute('title');
      }

      form.action = wantsPaper
        ? `/thank-you/?src=deskcopy&pb=${usuk ? 'us' : 'intl'}`
        : '/thank-you/?src=deskcopy';

      if (wantsPaper) {
        note.replaceChildren(
          `Your paperback total is $${cost}. This covers printing and shipping costs.`,
          document.createElement('br'),
          'Place your order to be taken to a secure Stripe checkout.',
          // for the reader who hears the page: the fields that appeared sit
          // after the paperback question, not here at the foot of the form
          Object.assign(document.createElement('span'), { className: 'sr-only', textContent: ' Shipping address fields now follow the paperback question.' }),
        );
      } else {
        note.replaceChildren();
      }
    }

    /* a paperback order goes on to Stripe from the thank-you page; the email
       goes along in session storage (same origin, gone when the tab closes) so
       Stripe's checkout can open with it filled in, and it never rides a URL
       through Netlify */
    form.addEventListener('submit', () => {
      const email = (document.getElementById('dc-email') as HTMLInputElement).value.trim();
      try { sessionStorage.setItem('deskcopy-email', format.value === 'Paperback' ? email : ''); } catch {}
    });

    country.addEventListener('change', update);
    advisory.addEventListener('change', update);
    format.addEventListener('change', update);
    update();
  </script>
</Base>
